{
  "name": "paperlab-desktop",
  "productName": "PaperLab",
  "version": "0.2.0",
  "description": "PaperLab, a local-first research reader, in its own window over Docker.",
  "homepage": "https://github.com/khannoussi-malek/PaperLab",
  "author": "malek khannoussi",
  "license": "Apache-2.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.check.json",
    "e2e": "npm run build && playwright test",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "io.github.khannoussi-malek.paperlab",
    "productName": "PaperLab",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*.js", "src/startup.html", "package.json"],
    "extraResources": [
      { "from": "docker-compose.yml", "to": "docker-compose.yml" },
      { "from": "../scripts/paperlab-mcp", "to": "scripts/paperlab-mcp" },
      { "from": "build/icon.png", "to": "icon.png" },
      { "from": "build/trayTemplate.png", "to": "trayTemplate.png" },
      { "from": "build/trayTemplate@2x.png", "to": "trayTemplate@2x.png" }
    ],
    "protocols": [{ "name": "PaperLab", "schemes": ["paperlab"] }],
    "artifactName": "PaperLab-${version}-${arch}.${ext}",
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "PaperLab uses the camera only while Hands mode is on, to follow your hands. The picture stays on this computer."
      }
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Education",
      "maintainer": "malek khannoussi"
    }
  }
}
