#!/bin/sh
# Starts PaperLab's MCP server inside the running api container, for Claude Desktop, Claude Code or another MCP
# client on macOS, Linux or WSL. Stdout carries the protocol, so every message of ours goes to stderr.

say() {
  printf 'paperlab-mcp: %s\n' "$1" >&2
}

# --install: write ~/.local/bin/paperlab-mcp, which runs this script, so every user's MCP config and Claude Code
# command read the same "$HOME/.local/bin/paperlab-mcp". A wrapper, not a symlink: the cd below finds the folder from $0.
if [ "${1:-}" = --install ]; then
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" || exit 1
  bin="${HOME:?}/.local/bin"
  mkdir -p "$bin" || exit 1
  quoted=$(printf '%s' "$self" | sed "s/'/'\\\\''/g")
  printf '#!/bin/sh\nexec '"'"'%s'"'"' "$@"\n' "$quoted" > "$bin/paperlab-mcp" || exit 1
  chmod 755 "$bin/paperlab-mcp" || exit 1
  say "installed $bin/paperlab-mcp, which runs $self."
  exit 0
fi

cd "$(dirname "$0")/.." || exit 1

# The desktop app copies this script to <its data folder>/scripts/, beside docker-compose.yml; the release tarball has the same layout. The per-user places come first: they exist only when this user installed that Docker.
# Apps like Claude Desktop don't get a terminal's PATH on macOS, hence the fixed places after `command -v`. The last
# one is for WSL: `wsl -e` is neither a login nor an interactive shell, so Docker Desktop's WSL integration never
# lands on PATH there either, and `PAPERLAB_DOCKER` set in Claude Desktop's config doesn't reach the distro.
# PAPERLAB_DOCKER_PATHS allows testing: space-separated paths to try; empty string disables fallbacks.
docker=
if [ -z "${PAPERLAB_DOCKER_PATHS+x}" ]; then
  # Default fallback paths for macOS and Linux (desktop/src/docker.ts keeps the same list, in the same order).
  fallback_paths="${HOME:-}/.docker/bin/docker ${HOME:-}/.rd/bin/docker /usr/local/bin/docker /opt/homebrew/bin/docker /usr/bin/docker ${HOME:-}/.orbstack/bin/docker /Applications/Docker.app/Contents/Resources/bin/docker /mnt/wsl/docker-desktop/cli-tools/usr/bin/docker"
else
  fallback_paths="${PAPERLAB_DOCKER_PATHS}"
fi
for candidate in "${PAPERLAB_DOCKER:-}" "$(command -v docker)" $fallback_paths; do
  if [ -n "$candidate" ] && [ -f "$candidate" ] && [ -x "$candidate" ]; then
    docker=$candidate
    break
  fi
done
if [ -z "$docker" ]; then
  say 'docker was not found. Install Docker, or set PAPERLAB_DOCKER to its full path.'
  exit 1
fi

services=$("$docker" compose ps --status running --services 2>&1)
case $services in
  *'permission denied'*)
    say 'Docker refused access (permission denied). On Linux, add your user to the docker group: sudo usermod -aG docker $USER, then log out and back in.'
    exit 1
    ;;
esac
if ! printf '%s\n' "$services" | grep -qx api; then
  say "PaperLab isn't running. Open the PaperLab app, or run \"docker compose up -d\" in $(pwd)."
  exit 1
fi

exec "$docker" compose exec -T api python -m mcp_server
